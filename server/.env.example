PORT=3001

# Browser origin(s) allowed by CORS — no trailing slash. Accepts a
# comma-separated list for multiple origins (e.g. custom domain + vercel.app).
# Example: ALLOWED_ORIGIN=https://duodoro.live,https://duodoro.vercel.app
ALLOWED_ORIGIN=http://localhost:3000

# Supabase — find these in your Supabase dashboard > Settings > API
# Use the SERVICE ROLE key (not the anon key) — this bypasses RLS for server-side writes
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

# Upstash Redis Free: copy the TLS Redis connection URL from its Connect panel.
# Keep the URL (including its password) in Render only, never in the repository.
FOCUS_QUEUE_URL=rediss://default:your-password@your-database.upstash.io:6379
